# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings > API no painel do Supabase)

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-public

# URL pública do site (usada para gerar o QR code que aponta pra home).
# Em produção, use a URL do deploy (ex: Vercel). Em localhost, deixe como está.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
